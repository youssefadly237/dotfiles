# secrets example (to cp)
# identity
set realname = "Your Name"
set from = "your-email@example.com"

# IMAP settings
set imap_user = "your-email@example.com"
set imap_pass = "your-app-password"
set folder = "imaps://imap.mail.com/"
set spoolfile = "+INBOX"

# SMTP settings
set smtp_url = "smtp://your-email@example.com:587/"
set smtp_pass = "your-app-password"

# mail folders
mailboxes "+INBOX"
mailboxes "+[mail]/Starred"
# ... etc
