{
  "layer": "top",
  "position": "top",
  // "width": 1920,
  "modules-left": ["niri/workspaces", "custom/music", "custom/pomodoro"],
  "modules-center": [
    "custom/launcher",
    "custom/cpu",
    "custom/ram",
    "custom/gpu",
    "clock",
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "bluetooth",
    "backlight",
    "battery",
    "tray",
    "custom/lock",
    "custom/power",
  ],
  "tray": {
    "icon-size": 21,
    "spacing": 10,
  },
  "custom/launcher": {
    "format": "",
    "on-click": "pkill -0 fuzzel || fuzzel",
    "tooltip": false,
  },
  "custom/music": {
    "exec": "~/.scripts/bar/spotify.bash full",
    "interval": 1,
    "return-type": "json",
    "format": "  {text}",
    "tooltip": true,
    "on-click": "~/.scripts/bar/spotify.bash next",
    "on-click-right": "~/.scripts/bar/spotify.bash previous",
    "on-click-middle": "~/.scripts/bar/spotify.bash play-pause",
    "on-scroll-up": "~/.scripts/bar/spotify.bash vol-up",
    "on-scroll-down": "~/.scripts/bar/spotify.bash vol-down",
    "on-click-forward": "~/.scripts/bar/spotify.bash seek-forward",
    "on-click-backward": "~/.scripts/bar/spotify.bash seek-backward",
    "max-length": 25,
  },
  "clock": {
    "timezone": "Africa/Cairo",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "󰃭 {:%a %d %b %Y}",
    "format": " {:%I:%M %p}",
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰂄",
    "format-alt": "{icon}",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "],
    },
    "on-click": "pavucontrol",
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "sleep 0.5s && swaylock",
    "format": "",
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout &",
    "format": "",
  },
  "custom/cpu": {
    "exec": "~/.scripts/bar/sysmon.bash cpu",
    "interval": 2,
    "format": " {}%",
    "tooltip": true,
    "return-type": "json",
  },
  "custom/ram": {
    "exec": "~/.scripts/bar/sysmon.bash ram",
    "interval": 5,
    "format": " {}%",
    "tooltip": true,
    "return-type": "json",
  },
  "custom/gpu": {
    "exec": "~/.scripts/bar/sysmon.bash gpu",
    "interval": 5,
    "format": "  {}%",
    "tooltip": true,
    "return-type": "json",
  },
  "custom/pomodoro": {
    "exec": "~/.scripts/bar/pomodoro.bash",
    "return-type": "json",
    "interval": 1,
    "format": "󰔛 {text}",
    "escape": false,
    "tooltip": false,
    "on-click": "~/.scripts/bar/pomodoro.bash working",
    "on-click-middle": "~/.scripts/bar/pomodoro.bash toggle",
    "on-click-right": "~/.scripts/bar/pomodoro.bash wasting",
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 Disconnected",
    "format-alt": "󰖩 {essid}",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nSignal: {signalStrength}%\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "on-click-right": "nm-connection-editor",
    "on-click-middle": "nmcli device wifi rescan",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format-connected": "{controller_alias}\naddress: {controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "name:    {device_alias}\nbattery: {device_battery_percentage}%\naddress: {device_address}",
    "on-click": "blueman-manager || bluetoothctl",
  },
}
