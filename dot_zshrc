# === EXPORTS ===

# General environment
export TERM=xterm-256color
export MANPAGER="less -R --use-color -Dd+r -Du+b"
export RUST_BACKTRACE=1

# Ruby
export GEM_HOME="$HOME/gems"
export PATH="$GEM_HOME/bin:$PATH"

# Cargo
export PATH="$HOME/.cargo/bin:$PATH"

# Node/NVM (lazy)
export NVM_DIR="$HOME/.nvm"

nvm() {
  unset -f nvm node npm npx
  [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
  nvm "$@"
}
node() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"; node "$@" }
npm()  { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"; npm  "$@" }
npx()  { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"; npx  "$@" }

# Go
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export PATH="/usr/local/go/bin:$GOBIN:$PATH"

# Haskell/GHCup
[ -f "$HOME/.ghcup/env" ] && source "$HOME/.ghcup/env"

# Zig
export PATH="/opt/zig-0.15.2:$PATH"

# Android
export ANDROID_HOME="$HOME/Android/Sdk"
export NDK_HOME="$ANDROID_HOME/ndk/29.0.13599879"
export PATH="$ANDROID_HOME/emulator:$PATH"
export PATH="$ANDROID_HOME/tools:$PATH"
export PATH="$ANDROID_HOME/tools/bin:$PATH"
export PATH="$ANDROID_HOME/platform-tools:$PATH"
export PATH="/opt/android-studio/bin:$PATH"

# Flutter
export PATH="$HOME/development/flutter/bin:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Development tools
export PATH="$HOME/Apps/android-studio/bin:$PATH"
export PATH="$HOME/.spicetify:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/Apps/typst-x86_64-unknown-linux-musl:$PATH"
export PATH="/opt/nvim-linux-x86_64/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export MASONBIN="$HOME/.local/share/nvim/mason/bin"

# editor
export EDITOR='nvim'
export VISUAL='nvim'
export SUDO_EDITOR='nvim'

# === PROMPT ===
eval "$(starship init zsh)"

# === SSH AGENT ===
if ! pgrep -u "$USER" ssh-agent >/dev/null; then
    eval "$(ssh-agent -s)"
fi

# === HISTORY ===
setopt histignorealldups sharehistory
HISTSIZE=5000
SAVEHIST=5000
HISTFILE=~/.zsh_history

# === COMPLETION ===
fpath+=~/.zfunc
fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit
compinit
zstyle ':completion:*' expand 'yes'
zstyle ':completion:*' squeeze-slashes 'yes'
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _expand _complete _correct _approximate
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' menu select=2
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' verbose true

# === SOURCE EXTERNAL CONFIGS ===

# Rust/Cargo
source "$HOME/.cargo/env"

# Deno
source "$HOME/.deno/env"

# Gradle
source /etc/profile.d/gradle.sh

# XMake
[[ -f "$HOME/.xmake/profile" ]] && source "$HOME/.xmake/profile"

# zsh history
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='bg=black,fg=green,bold'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='bg=black,fg=red,bold'
source "$HOME/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh"

# === KEYBINDING ===
bindkey -v

bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

# === ALIASES ===
alias ls='ls --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias nivm='nvim'
alias beep='taskbeep'
alias c='clear'
alias vmon='krfb-virtualmonitor --name PhoneDisplay --resolution 2460x1080 --password 123 --port 5900'
alias getidf='source $HOME/development/esp-idf/export.sh'

# Arduino
alias a-monitor='arduino-cli monitor -p /dev/ttyUSB0 --config 115200 -b esp32:esp32:node32s'
alias a-compile='arduino-cli compile -b esp32:esp32:node32s'
alias a-uploud='arduino-cli upload -b esp32:esp32:node32s -p /dev/ttyUSB0'

# === CUSTOM FUNCTIONS ===
source ~/.zsh/functions/venvon.zsh
source ~/.zsh/functions/update-discord.zsh
source ~/.zsh/functions/tts_convert.zsh
source ~/.zsh/functions/lazy.zsh
source ~/.zsh/functions/gen-completions.sh


function clearpycache() {
  echo "Clearing all __pycache__ folders under $(pwd)..."
  find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null
  echo "All cleared up"
}
